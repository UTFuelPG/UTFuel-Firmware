<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    x:Class="UTFuel.TestBench.Gui.App"

    RequestedThemeVariant="Dark">

    <Application.Styles>

        <FluentTheme />

        <StyleInclude
            Source="avares://UTFuel.TestBench.Gui/Themes/UTFuelTokens.axaml" />

        <StyleInclude
            Source="avares://UTFuel.TestBench.Gui/Themes/UTFuelControls.axaml" />

    </Application.Styles>

</Application>