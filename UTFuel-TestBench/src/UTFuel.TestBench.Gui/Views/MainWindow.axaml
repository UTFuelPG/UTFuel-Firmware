<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:vm="using:UTFuel.TestBench.Gui.ViewModels"
    xmlns:controls="using:UTFuel.TestBench.Gui.Controls"

    x:Class="UTFuel.TestBench.Gui.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"

    Title="UTFuel TestBench"

    Width="1350"
    Height="850"

    MinWidth="1050"
    MinHeight="700">


    <Grid
        RowDefinitions="Auto,*">


        <!-- ================================================= -->
        <!-- APPLICATION HEADER -->
        <!-- ================================================= -->

        <controls:AppHeader
            Grid.Row="0" />



        <!-- ================================================= -->
        <!-- APPLICATION BODY -->
        <!-- ================================================= -->

        <Grid
            Grid.Row="1"
            ColumnDefinitions="240,*">


            <!-- ============================================= -->
            <!-- SIDEBAR -->
            <!-- ============================================= -->

            <Border
                Grid.Column="0"
                Background="{DynamicResource UtfuelSurfaceBrush}"
                BorderBrush="{DynamicResource UtfuelBorderBrush}"
                BorderThickness="0,0,1,0">


                <Grid
                    RowDefinitions="*,Auto">


                    <!-- ===================================== -->
                    <!-- NAVIGATION -->
                    <!-- ===================================== -->

                    <ScrollViewer
                        Grid.Row="0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">


                        <StackPanel
                            Margin="12,20,12,16"
                            Spacing="4">


                            <!-- ============================= -->
                            <!-- OVERVIEW -->
                            <!-- ============================= -->

                            <TextBlock
                                Classes="eyebrow"
                                Margin="14,0,0,6"
                                Text="{DynamicResource NavSectionOverview}" />


                            <Button
                                x:Name="OverviewNavButton"
                                Classes="nav-item"
                                Tag="Overview"
                                Click="NavigationButton_Click"
                                Content="{DynamicResource NavOverview}" />



                            <!-- ============================= -->
                            <!-- CONTROL -->
                            <!-- ============================= -->

                            <TextBlock
                                Classes="eyebrow"
                                Margin="14,20,0,6"
                                Text="{DynamicResource NavSectionControl}" />


                            <Button
                                x:Name="ManualNavButton"
                                Classes="nav-item"
                                Tag="Manual"
                                Click="NavigationButton_Click"
                                Content="{DynamicResource NavManualControl}" />


                            <Button
                                x:Name="BenchmarkNavButton"
                                Classes="nav-item"
                                Tag="Benchmark"
                                Click="NavigationButton_Click"
                                Content="{DynamicResource NavDynamicBenchmark}" />



                            <!-- ============================= -->
                            <!-- ANALYSIS -->
                            <!-- ============================= -->

                            <TextBlock
                                Classes="eyebrow"
                                Margin="14,20,0,6"
                                Text="{DynamicResource NavSectionAnalysis}" />


                            <Button
                                x:Name="TelemetryNavButton"
                                Classes="nav-item"
                                Tag="Telemetry"
                                Click="NavigationButton_Click"
                                Content="{DynamicResource NavLiveTelemetry}" />


                            <Button
                                x:Name="ValidationNavButton"
                                Classes="nav-item"
                                Tag="Validation"
                                Click="NavigationButton_Click"
                                Content="{DynamicResource NavValidation}" />



                            <!-- ============================= -->
                            <!-- TOOLS -->
                            <!-- ============================= -->

                            <TextBlock
                                Classes="eyebrow"
                                Margin="14,20,0,6"
                                Text="{DynamicResource NavSectionTools}" />


                            <Button
                                x:Name="ShowcaseNavButton"
                                Classes="nav-item"
                                Tag="Showcase"
                                Click="NavigationButton_Click"
                                Content="{DynamicResource NavShowcase}" />


                        </StackPanel>


                    </ScrollViewer>



                    <!-- ===================================== -->
                    <!-- SIDEBAR FOOTER -->
                    <!-- ===================================== -->

                    <Border
                        Grid.Row="1"
                        Padding="16"
                        BorderBrush="{DynamicResource UtfuelBorderBrush}"
                        BorderThickness="0,1,0,0">


                        <StackPanel
                            Spacing="14">


                            <controls:LanguageSelector />


                            <Grid
                                ColumnDefinitions="*,Auto">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="2">

                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="UTFuel TestBench" />

                                    <TextBlock
                                        Classes="muted"
                                        FontSize="11"
                                        Text="Development Build" />

                                </StackPanel>


                                <TextBlock
                                    Grid.Column="1"
                                    Classes="muted"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Text="v0.1.0-dev" />

                            </Grid>


                        </StackPanel>


                    </Border>


                </Grid>


            </Border>



            <!-- ============================================= -->
            <!-- PAGE HOST -->
            <!-- ============================================= -->

            <Border
                Grid.Column="1"
                Background="{DynamicResource UtfuelBackgroundBrush}">


                <ContentControl
                    x:Name="PageHost" />


            </Border>


        </Grid>


    </Grid>


</Window>