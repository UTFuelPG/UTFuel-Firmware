<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:UTFuel.TestBench.Gui.ViewModels"

    x:Class="UTFuel.TestBench.Gui.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"

    Title="UTFuel TestBench"
    Width="1350"
    Height="850"
    MinWidth="1050"
    MinHeight="700">

    <Grid RowDefinitions="Auto,*">


        <!-- ====================================== -->
        <!-- CONNECTION BAR -->
        <!-- ====================================== -->

        <Border
            Grid.Row="0"
            Padding="16"
            BorderThickness="0,0,0,1">

            <Grid
                ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                ColumnSpacing="10">

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="UTFuel ECU" />

                <TextBox
                    Grid.Column="1"
                    Text="{Binding FirmwarePath}"
                    PlaceholderText="Path to utfuel_host.exe" />

                <Button
                    Grid.Column="2"
                    Content="CONNECT"
                    Command="{Binding ConnectCommand}" />

                <Button
                    Grid.Column="3"
                    Content="DISCONNECT"
                    Command="{Binding DisconnectCommand}" />

                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="{Binding ConnectionStatus}" />

            </Grid>

        </Border>


        <!-- ====================================== -->
        <!-- MAIN TABS -->
        <!-- ====================================== -->

        <TabControl Grid.Row="1">


            <!-- ================================== -->
            <!-- DASHBOARD -->
            <!-- ================================== -->

            <TabItem Header="Dashboard">

                <ScrollViewer>

                    <StackPanel
                        Margin="24"
                        Spacing="20">


                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Text="UTFuel Dashboard" />


                        <!-- TARGET + ECU -->

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="20">


                            <!-- TARGET -->

                            <Border
                                Grid.Column="0"
                                Padding="20"
                                BorderThickness="1"
                                CornerRadius="8">

                                <StackPanel
                                    Spacing="12">

                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Text="TARGET / SIMULATOR" />

                                    <TextBlock
                                        Text="{Binding BenchmarkPhase,
                                            StringFormat='Phase: {0}'}" />

                                    <TextBlock
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Text="{Binding TargetRpm,
                                            StringFormat='RPM: {0}'}" />

                                    <TextBlock
                                        Text="{Binding TargetTpsPercent,
                                            StringFormat='TPS: {0:F2} %'}" />

                                    <TextBlock
                                        Text="{Binding TargetMapKpa,
                                            StringFormat='MAP: {0:F2} kPa'}" />

                                    <TextBlock
                                        Text="{Binding TargetSpeedKmh,
                                            StringFormat='Speed: {0:F2} km/h'}" />

                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Text="{Binding TargetGear,
                                            StringFormat='Target Gear: {0}'}" />

                                </StackPanel>

                            </Border>


                            <!-- ECU -->

                            <Border
                                Grid.Column="1"
                                Padding="20"
                                BorderThickness="1"
                                CornerRadius="8">

                                <StackPanel
                                    Spacing="12">

                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Text="UTFuel ECU" />

                                    <TextBlock
                                        FontSize="32"
                                        FontWeight="Bold"
                                        Text="{Binding EcuRpm,
                                            StringFormat='RPM: {0}'}" />

                                    <TextBlock
                                        Text="{Binding EcuTpsPercent,
                                            StringFormat='TPS: {0:F2} %'}" />

                                    <TextBlock
                                        Text="{Binding EcuMapKpa,
                                            StringFormat='MAP: {0:F2} kPa'}" />

                                    <TextBlock
                                        Text="{Binding EcuBatteryVoltage,
                                            StringFormat='Battery: {0:F2} V'}" />

                                    <TextBlock
                                        Text="{Binding EcuSpeedKmh,
                                            StringFormat='Speed: {0:F2} km/h'}" />

                                    <TextBlock
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Text="{Binding EcuGear,
                                            StringFormat='GEAR: {0}'}" />

                                    <TextBlock
                                        FontSize="22"
                                        FontWeight="Bold"
                                        Text="{Binding EcuShiftWarning,
                                            StringFormat='SHIFT: {0}'}" />

                                </StackPanel>

                            </Border>

                        </Grid>


                        <!-- TARGET VS ECU -->

                        <Border
                            Padding="20"
                            BorderThickness="1"
                            CornerRadius="8">

                            <StackPanel
                                Spacing="12">

                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Text="TARGET vs ECU" />


                                <Grid
                                    ColumnDefinitions="140,*,*,*"
                                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                    RowSpacing="10"
                                    ColumnSpacing="12">


                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontWeight="Bold"
                                        Text="TARGET" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        FontWeight="Bold"
                                        Text="ECU" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        FontWeight="Bold"
                                        Text="ERROR" />


                                    <!-- RPM -->

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="RPM" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding TargetRpm}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Text="{Binding EcuRpm}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="3"
                                        Text="{Binding RpmError}" />


                                    <!-- TPS -->

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Text="TPS %" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="{Binding TargetTpsPercent,
                                            StringFormat='Target: {0:F2}'}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Text="{Binding EcuTpsPercent,
                                            StringFormat='ECU: {0:F2}'}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="3"
                                        Text="{Binding TpsErrorPercent,
                                            StringFormat='Error: {0:F4}'}" />


                                    <!-- MAP -->

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Text="MAP kPa" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Text="{Binding TargetMapKpa,
                                            StringFormat='Target: {0:F2}'}" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        Text="{Binding EcuMapKpa,
                                            StringFormat='ECU: {0:F2}'}" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="3"
                                        Text="{Binding MapErrorKpa,
                                            StringFormat='Error: {0:F4}'}" />


                                    <!-- SPEED -->

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Text="Speed km/h" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Text="{Binding TargetSpeedKmh,
                                            StringFormat='Target: {0:F2}'}" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="2"
                                        Text="{Binding EcuSpeedKmh,
                                            StringFormat='ECU: {0:F2}'}" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="3"
                                        Text="{Binding SpeedErrorKmh,
                                            StringFormat='Error: {0:F4}'}" />

                                </Grid>

                            </StackPanel>

                        </Border>


                        <!-- COMMUNICATION -->

                        <Border
                            Padding="20"
                            BorderThickness="1"
                            CornerRadius="8">

                            <StackPanel
                                Spacing="8">

                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Text="Communication" />


                                <Grid
                                    ColumnDefinitions="*,*,*"
                                    RowDefinitions="Auto,Auto,Auto,Auto"
                                    RowSpacing="8">


                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{Binding PacketsSent,
                                            StringFormat='Sent: {0}'}" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Text="{Binding PacketsReceived,
                                            StringFormat='Received: {0}'}" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Text="{Binding PacketsLost,
                                            StringFormat='Lost: {0}'}" />


                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="{Binding PacketLossPercent,
                                            StringFormat='Loss: {0:F3} %'}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding MeasuredUpdateRateHz,
                                            StringFormat='Rate: {0:F0} Hz'}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Text="{Binding CurrentRttMs,
                                            StringFormat='Current RTT: {0:F3} ms'}" />


                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Text="{Binding AverageRttMs,
                                            StringFormat='Average: {0:F3} ms'}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="{Binding MinimumRttMs,
                                            StringFormat='Minimum: {0:F3} ms'}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Text="{Binding MaximumRttMs,
                                            StringFormat='Maximum: {0:F3} ms'}" />


                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Text="{Binding P95RttMs,
                                            StringFormat='P95: {0:F3} ms'}" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Text="{Binding P99RttMs,
                                            StringFormat='P99: {0:F3} ms'}" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        Text="{Binding JitterMs,
                                            StringFormat='Jitter: {0:F3} ms'}" />

                                </Grid>


                                <Button
                                    Margin="0,10,0,0"
                                    Width="170"
                                    HorizontalAlignment="Left"
                                    Content="RESET STATISTICS"
                                    Command="{Binding ResetStatisticsCommand}" />

                            </StackPanel>

                        </Border>


                        <TextBlock
                            Text="{Binding LastMessage}" />

                    </StackPanel>

                </ScrollViewer>

            </TabItem>



            <!-- ================================== -->
            <!-- MANUAL -->
            <!-- ================================== -->

            <TabItem Header="Manual">

                <ScrollViewer>

                    <StackPanel
                        Margin="24"
                        Spacing="18">


                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Text="Manual Sensor Control" />


                        <TextBlock
                            TextWrapping="Wrap"
                            Text="Define exact sensor values or use the sliders. LIVE SEND continuously sends the current values to the ECU." />


                        <StackPanel
                            Spacing="16"
                            IsEnabled="{Binding CanEditManualInputs}">


                            <!-- NUMERIC VALUES -->

                            <Grid
                                ColumnDefinitions="240,220"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                RowSpacing="10"
                                ColumnSpacing="16">


                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="TPS Voltage" />

                                <NumericUpDown
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="5"
                                    Increment="0.1"
                                    Value="{Binding ManualTpsVoltage}" />


                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="MAP Voltage" />

                                <NumericUpDown
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="5"
                                    Increment="0.1"
                                    Value="{Binding ManualMapVoltage}" />


                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Text="Coolant Resistance (ohm)" />

                                <NumericUpDown
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100000"
                                    Value="{Binding ManualCoolantResistance}" />


                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Text="IAT Resistance (ohm)" />

                                <NumericUpDown
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100000"
                                    Value="{Binding ManualIntakeResistance}" />


                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Text="Battery Voltage" />

                                <NumericUpDown
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="20"
                                    Increment="0.1"
                                    Value="{Binding ManualBatteryVoltage}" />


                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Text="Engine RPM" />

                                <NumericUpDown
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="20000"
                                    Increment="100"
                                    Value="{Binding ManualRpm}" />


                                <TextBlock
                                    Grid.Row="6"
                                    Grid.Column="0"
                                    Text="Vehicle Speed (km/h)" />

                                <NumericUpDown
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="400"
                                    Increment="1"
                                    Value="{Binding ManualSpeedKmh}" />

                            </Grid>


                            <!-- QUICK CONTROL -->

                            <TextBlock
                                Margin="0,20,0,0"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="Quick Control" />


                            <Grid
                                ColumnDefinitions="100,*,150"
                                RowDefinitions="Auto,Auto,Auto,Auto"
                                RowSpacing="14"
                                ColumnSpacing="12">


                                <!-- TPS -->

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="TPS" />

                                <Slider
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Minimum="0.5"
                                    Maximum="4.5"
                                    Value="{Binding ManualTpsVoltageSlider,
                                        Mode=TwoWay}" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="{Binding ManualTpsVoltage,
                                        StringFormat='TPS: {0:F2} V'}" />


                                <!-- MAP -->

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="MAP" />

                                <Slider
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Minimum="0.5"
                                    Maximum="4.5"
                                    Value="{Binding ManualMapVoltageSlider,
                                        Mode=TwoWay}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="{Binding ManualMapVoltage,
                                        StringFormat='MAP: {0:F2} V'}" />


                                <!-- RPM -->

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="RPM" />

                                <Slider
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="12000"
                                    Value="{Binding ManualRpmSlider,
                                        Mode=TwoWay}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="{Binding ManualRpm,
                                        StringFormat='RPM: {0:F0}'}" />


                                <!-- SPEED -->

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="Speed" />

                                <Slider
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="250"
                                    Value="{Binding ManualSpeedSlider,
                                        Mode=TwoWay}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="{Binding ManualSpeedKmh,
                                        StringFormat='Speed: {0:F1}'}" />

                            </Grid>


                            <!-- SINGLE SEND -->

                            <Button
                                Width="180"
                                HorizontalAlignment="Left"
                                Content="SEND TO ECU"
                                IsEnabled="{Binding CanSendManual}"
                                Command="{Binding SendManualCommand}" />


                            <!-- LIVE SEND -->

                            <Border
                                Margin="0,20,0,0"
                                Padding="16"
                                BorderThickness="1"
                                CornerRadius="8">

                                <StackPanel
                                    Spacing="12">

                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Text="LIVE SEND" />


                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="10">

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="Update rate:" />

                                        <NumericUpDown
                                            Width="90"
                                            Minimum="1"
                                            Maximum="100"
                                            Value="{Binding ManualUpdateRateHz}" />

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="Hz" />

                                    </StackPanel>


                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="10">

                                        <Button
                                            Width="150"
                                            Content="START LIVE"
                                            IsEnabled="{Binding CanStartManualLive}"
                                            Command="{Binding StartManualLiveCommand}" />

                                        <Button
                                            Width="150"
                                            Content="STOP LIVE"
                                            IsEnabled="{Binding CanStopManualLive}"
                                            Command="{Binding StopManualLiveCommand}" />

                                    </StackPanel>


                                    <TextBlock
                                        FontWeight="Bold"
                                        Text="{Binding IsManualLiveRunning,
                                            StringFormat='Running: {0}'}" />

                                </StackPanel>

                            </Border>

                        </StackPanel>


                        <TextBlock
                            Text="{Binding LastMessage}" />

                    </StackPanel>

                </ScrollViewer>

            </TabItem>



            <!-- ================================== -->
            <!-- DYNAMIC BENCHMARK -->
            <!-- ================================== -->

            <TabItem Header="Dynamic Benchmark">

                <ScrollViewer>

                    <StackPanel
                        Margin="24"
                        Spacing="20">


                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Text="Dynamic Benchmark" />


                        <TextBlock
                            MaxWidth="850"
                            HorizontalAlignment="Left"
                            TextWrapping="Wrap"
                            Text="Runs a continuous simulated driving cycle. RPM, TPS, MAP, vehicle speed and gears change automatically until the benchmark is stopped." />


                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12">

                            <Button
                                Width="190"
                                Content="START BENCHMARK"
                                IsEnabled="{Binding CanStartBenchmark}"
                                Command="{Binding StartBenchmarkCommand}" />

                            <Button
                                Width="190"
                                Content="STOP BENCHMARK"
                                IsEnabled="{Binding CanStopBenchmark}"
                                Command="{Binding StopBenchmarkCommand}" />

                        </StackPanel>


                        <Border
                            Padding="24"
                            BorderThickness="1"
                            CornerRadius="8">

                            <StackPanel
                                Spacing="14">

                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Text="{Binding BenchmarkPhase,
                                        StringFormat='Phase: {0}'}" />


                                <TextBlock
                                    FontSize="42"
                                    FontWeight="Bold"
                                    Text="{Binding EcuRpm,
                                        StringFormat='RPM: {0}'}" />


                                <TextBlock
                                    FontSize="34"
                                    FontWeight="Bold"
                                    Text="{Binding EcuGear,
                                        StringFormat='GEAR: {0}'}" />


                                <TextBlock
                                    FontSize="20"
                                    Text="{Binding EcuTpsPercent,
                                        StringFormat='TPS: {0:F1} %'}" />


                                <TextBlock
                                    FontSize="20"
                                    Text="{Binding EcuMapKpa,
                                        StringFormat='MAP: {0:F1} kPa'}" />


                                <TextBlock
                                    FontSize="20"
                                    Text="{Binding EcuSpeedKmh,
                                        StringFormat='Speed: {0:F1} km/h'}" />


                                <TextBlock
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Text="{Binding EcuShiftWarning,
                                        StringFormat='SHIFT: {0}'}" />


                                <TextBlock
                                    Text="{Binding CurrentRttMs,
                                        StringFormat='RTT: {0:F3} ms'}" />

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>



            <!-- ================================== -->
            <!-- SHOWCASE -->
            <!-- ================================== -->

            <TabItem Header="Showcase">

                <Grid
                    Margin="30"
                    RowDefinitions="Auto,*,Auto">


                    <TextBlock
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        FontSize="32"
                        FontWeight="Bold"
                        Text="UTFuel Electronic Management Platform" />


                    <StackPanel
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="18">


                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="72"
                            FontWeight="Bold"
                            Text="{Binding EcuRpm,
                                StringFormat='RPM: {0}'}" />


                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="80"
                            FontWeight="Bold"
                            Text="{Binding EcuGear,
                                StringFormat='GEAR: {0}'}" />


                        <Grid
                            Width="700"
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="14">


                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                FontSize="24"
                                Text="{Binding EcuTpsPercent,
                                    StringFormat='TPS: {0:F1} %'}" />


                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                FontSize="24"
                                Text="{Binding EcuMapKpa,
                                    StringFormat='MAP: {0:F1} kPa'}" />


                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                FontSize="24"
                                Text="{Binding EcuSpeedKmh,
                                    StringFormat='Speed: {0:F1} km/h'}" />


                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="24"
                                Text="{Binding EcuBatteryVoltage,
                                    StringFormat='Battery: {0:F2} V'}" />


                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                FontSize="20"
                                Text="{Binding CurrentRttMs,
                                    StringFormat='ECU Response: {0:F3} ms'}" />


                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                FontSize="20"
                                Text="{Binding PacketLossPercent,
                                    StringFormat='Packet Loss: {0:F3} %'}" />

                        </Grid>


                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="36"
                            FontWeight="Bold"
                            Text="{Binding EcuShiftWarning,
                                StringFormat='SHIFT: {0}'}" />

                    </StackPanel>


                    <StackPanel
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">

                        <Button
                            Width="200"
                            Content="START SHOWCASE"
                            IsEnabled="{Binding CanStartBenchmark}"
                            Command="{Binding StartBenchmarkCommand}" />

                        <Button
                            Width="200"
                            Content="STOP SHOWCASE"
                            IsEnabled="{Binding CanStopBenchmark}"
                            Command="{Binding StopBenchmarkCommand}" />

                    </StackPanel>

                </Grid>

            </TabItem>



            <!-- ================================== -->
            <!-- TESTS -->
            <!-- ================================== -->

            <TabItem Header="Tests">

                <StackPanel
                    Margin="24"
                    Spacing="14">

                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Text="Automated Validation" />

                    <TextBlock
                        Text="Communication Benchmark" />

                    <TextBlock
                        Text="TPS Sweep" />

                    <TextBlock
                        Text="MAP Sweep" />

                    <TextBlock
                        Text="Gear Detection" />

                    <TextBlock
                        Text="Shift Indicator" />

                    <TextBlock
                        Margin="0,20,0,0"
                        TextWrapping="Wrap"
                        Text="The existing validation engine will be connected to this page in the next step." />

                </StackPanel>

            </TabItem>


        </TabControl>

    </Grid>

</Window>