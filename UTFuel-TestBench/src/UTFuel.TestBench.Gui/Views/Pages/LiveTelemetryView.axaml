<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:vm="using:UTFuel.TestBench.Gui.ViewModels"
    xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"

    x:Class="UTFuel.TestBench.Gui.Views.Pages.LiveTelemetryView"
    x:DataType="vm:MainWindowViewModel">


    <ScrollViewer>

        <StackPanel
            Margin="28"
            Spacing="20">


            <!-- ================================================= -->
            <!-- PAGE HEADER -->
            <!-- ================================================= -->

            <Grid
                ColumnDefinitions="*,Auto">


                <StackPanel
                    Grid.Column="0"
                    Spacing="5">

                    <TextBlock
                        Classes="title"
                        Text="{DynamicResource NavLiveTelemetry}" />

                    <TextBlock
                        Classes="muted"
                        TextWrapping="Wrap"
                        Text="{DynamicResource TelemetrySubtitle}" />

                </StackPanel>


                <Border
                    Grid.Column="1"
                    Classes="status"
                    VerticalAlignment="Center">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">

                        <Border
                            Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="{DynamicResource UtfuelAccentBrush}" />

                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{DynamicResource TelemetryRate}" />

                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{Binding MeasuredUpdateRateHz,
                                StringFormat='{}{0:F0}'}" />

                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Hz" />

                    </StackPanel>

                </Border>


            </Grid>



            <!-- ================================================= -->
            <!-- LIVE SUMMARY -->
            <!-- ================================================= -->

            <Grid
                ColumnDefinitions="*,*,*,*,*"
                ColumnSpacing="12">


                <!-- RPM -->

                <Border
                    Grid.Column="0"
                    Classes="card">

                    <StackPanel
                        Spacing="5">

                        <TextBlock
                            Classes="eyebrow"
                            Text="RPM" />

                        <TextBlock
                            FontSize="26"
                            FontWeight="SemiBold"
                            Text="{Binding EcuRpm}" />

                    </StackPanel>

                </Border>



                <!-- TPS -->

                <Border
                    Grid.Column="1"
                    Classes="card">

                    <StackPanel
                        Spacing="5">

                        <TextBlock
                            Classes="eyebrow"
                            Text="TPS" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4">

                            <TextBlock
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="{Binding EcuTpsPercent,
                                    StringFormat='{}{0:F1}'}" />

                            <TextBlock
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="%" />

                        </StackPanel>

                    </StackPanel>

                </Border>



                <!-- MAP -->

                <Border
                    Grid.Column="2"
                    Classes="card">

                    <StackPanel
                        Spacing="5">

                        <TextBlock
                            Classes="eyebrow"
                            Text="MAP" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4">

                            <TextBlock
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="{Binding EcuMapKpa,
                                    StringFormat='{}{0:F1}'}" />

                            <TextBlock
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="kPa" />

                        </StackPanel>

                    </StackPanel>

                </Border>



                <!-- SPEED -->

                <Border
                    Grid.Column="3"
                    Classes="card">

                    <StackPanel
                        Spacing="5">

                        <TextBlock
                            Classes="eyebrow"
                            Text="{DynamicResource TelemetrySpeed}" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4">

                            <TextBlock
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="{Binding EcuSpeedKmh,
                                    StringFormat='{}{0:F1}'}" />

                            <TextBlock
                                FontSize="17"
                                FontWeight="SemiBold"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,3"
                                Text="km/h" />

                        </StackPanel>

                    </StackPanel>

                </Border>



                <!-- RTT -->

                <Border
                    Grid.Column="4"
                    Classes="card">

                    <StackPanel
                        Spacing="5">

                        <TextBlock
                            Classes="eyebrow"
                            Text="RTT" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4">

                            <TextBlock
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="{Binding CurrentRttMs,
                                    StringFormat='{}{0:F3}'}" />

                            <TextBlock
                                FontSize="17"
                                FontWeight="SemiBold"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,3"
                                Text="ms" />

                        </StackPanel>

                    </StackPanel>

                </Border>


            </Grid>



            <!-- ================================================= -->
            <!-- GRAPHS -->
            <!-- ================================================= -->

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="360,360"
                ColumnSpacing="16"
                RowSpacing="16">


                <!-- ============================================= -->
                <!-- RPM -->
                <!-- ============================================= -->

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Classes="card">

                    <Grid
                        RowDefinitions="Auto,*"
                        RowSpacing="12">


                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="*,Auto">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Classes="section-title"
                                    Text="{DynamicResource TelemetryEngineSpeed}" />

                                <TextBlock
                                    Classes="muted"
                                    Text="{DynamicResource TelemetryEngineSpeedDescription}" />

                            </StackPanel>


                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Classes="eyebrow"
                                Text="RPM" />

                        </Grid>


                        <ScottPlot:AvaPlot
                            x:Name="RpmPlot"
                            Grid.Row="1" />


                    </Grid>

                </Border>



                <!-- ============================================= -->
                <!-- TPS -->
                <!-- ============================================= -->

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Classes="card">

                    <Grid
                        RowDefinitions="Auto,*"
                        RowSpacing="12">


                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="*,Auto">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Classes="section-title"
                                    Text="{DynamicResource TelemetryThrottlePosition}" />

                                <TextBlock
                                    Classes="muted"
                                    Text="{DynamicResource TelemetryThrottleDescription}" />

                            </StackPanel>


                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Classes="eyebrow"
                                Text="%" />

                        </Grid>


                        <ScottPlot:AvaPlot
                            x:Name="TpsPlot"
                            Grid.Row="1" />


                    </Grid>

                </Border>



                <!-- ============================================= -->
                <!-- MAP -->
                <!-- ============================================= -->

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Classes="card">

                    <Grid
                        RowDefinitions="Auto,*"
                        RowSpacing="12">


                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="*,Auto">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Classes="section-title"
                                    Text="{DynamicResource TelemetryManifoldPressure}" />

                                <TextBlock
                                    Classes="muted"
                                    Text="{DynamicResource TelemetryManifoldDescription}" />

                            </StackPanel>


                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Classes="eyebrow"
                                Text="kPa" />

                        </Grid>


                        <ScottPlot:AvaPlot
                            x:Name="MapPlot"
                            Grid.Row="1" />


                    </Grid>

                </Border>



                <!-- ============================================= -->
                <!-- SPEED -->
                <!-- ============================================= -->

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Classes="card">

                    <Grid
                        RowDefinitions="Auto,*"
                        RowSpacing="12">


                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="*,Auto">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Classes="section-title"
                                    Text="{DynamicResource TelemetryVehicleSpeed}" />

                                <TextBlock
                                    Classes="muted"
                                    Text="{DynamicResource TelemetryVehicleSpeedDescription}" />

                            </StackPanel>


                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Classes="eyebrow"
                                Text="km/h" />

                        </Grid>


                        <ScottPlot:AvaPlot
                            x:Name="SpeedPlot"
                            Grid.Row="1" />


                    </Grid>

                </Border>


            </Grid>



            <!-- ================================================= -->
            <!-- COMMUNICATION -->
            <!-- ================================================= -->

            <Border
                Classes="card">

                <Grid
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="18">


                    <!-- PACKETS -->

                    <StackPanel
                        Grid.Column="0"
                        Spacing="4">

                        <TextBlock
                            Classes="eyebrow"
                            Text="{DynamicResource TelemetryPackets}" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="5">

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{DynamicResource TelemetryReceived}" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding PacketsReceived}" />

                        </StackPanel>

                    </StackPanel>



                    <!-- LOSS -->

                    <StackPanel
                        Grid.Column="1"
                        Spacing="4">

                        <TextBlock
                            Classes="eyebrow"
                            Text="{DynamicResource TelemetryPacketLoss}" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4">

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding PacketLossPercent,
                                    StringFormat='{}{0:F3}'}" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="%" />

                        </StackPanel>

                    </StackPanel>



                    <!-- P99 -->

                    <StackPanel
                        Grid.Column="2"
                        Spacing="4">

                        <TextBlock
                            Classes="eyebrow"
                            Text="P99 RTT" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4">

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding P99RttMs,
                                    StringFormat='{}{0:F3}'}" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="ms" />

                        </StackPanel>

                    </StackPanel>



                    <!-- JITTER -->

                    <StackPanel
                        Grid.Column="3"
                        Spacing="4">

                        <TextBlock
                            Classes="eyebrow"
                            Text="{DynamicResource TelemetryJitter}" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4">

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding JitterMs,
                                    StringFormat='{}{0:F3}'}" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="ms" />

                        </StackPanel>

                    </StackPanel>


                </Grid>

            </Border>


        </StackPanel>

    </ScrollViewer>


</UserControl>