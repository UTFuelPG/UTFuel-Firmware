<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:UTFuel.TestBench.Gui.ViewModels"

    x:Class="UTFuel.TestBench.Gui.Views.Pages.ValidationView"
    x:DataType="vm:MainWindowViewModel">


    <ScrollViewer>

        <StackPanel
            Margin="28"
            Spacing="20">


            <!-- ================================================= -->
            <!-- PAGE HEADER -->
            <!-- ================================================= -->

            <Grid
                ColumnDefinitions="*,Auto">


                <StackPanel
                    Grid.Column="0"
                    Spacing="5">

                    <TextBlock
                        Classes="title"
                        Text="{DynamicResource NavValidation}" />

                    <TextBlock
                        Classes="muted"
                        TextWrapping="Wrap"
                        Text="{DynamicResource ValidationSubtitle}" />

                </StackPanel>


                <Border
                    Grid.Column="1"
                    Classes="status"
                    VerticalAlignment="Center">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">

                        <Border
                            Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="{DynamicResource UtfuelAccentBrush}" />

                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{Binding OverallValidationStatus}" />

                    </StackPanel>

                </Border>


            </Grid>



            <!-- ================================================= -->
            <!-- CONTROL PANEL -->
            <!-- ================================================= -->

            <Border
                Classes="card">

                <Grid
                    ColumnDefinitions="*,Auto">


                    <StackPanel
                        Grid.Column="0"
                        Spacing="5">

                        <TextBlock
                            Classes="section-title"
                            Text="{DynamicResource ValidationSuite}" />

                        <TextBlock
                            Classes="muted"
                            Text="{DynamicResource ValidationSuiteDescription}" />

                    </StackPanel>


                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10">

                        <Button
                            Classes="primary"
                            Width="170"
                            Content="{DynamicResource ValidationRunAll}"
                            IsEnabled="{Binding CanStartValidation}"
                            Command="{Binding RunAllTestsCommand}" />

                        <Button
                            Classes="danger"
                            Width="120"
                            Content="{DynamicResource ValidationStop}"
                            IsEnabled="{Binding CanStopValidation}"
                            Command="{Binding StopValidationCommand}" />

                        <Button
                            Classes="secondary"
                            Width="120"
                            Content="{DynamicResource ValidationReset}"
                            IsEnabled="{Binding CanStartValidation}"
                            Command="{Binding ResetValidationResultsCommand}" />

                    </StackPanel>


                </Grid>

            </Border>



            <!-- ================================================= -->
            <!-- PROGRESS -->
            <!-- ================================================= -->

            <Border
                Classes="card">

                <StackPanel
                    Spacing="14">


                    <Grid
                        ColumnDefinitions="*,Auto">


                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">

                            <TextBlock
                                Classes="eyebrow"
                                Text="{DynamicResource ValidationCurrentStep}" />

                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{Binding ValidationCurrentStep}" />

                        </StackPanel>



                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Spacing="4">

                            <TextBlock
                                Classes="eyebrow"
                                HorizontalAlignment="Right"
                                Text="{DynamicResource ValidationProgress}" />

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="4">

                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{Binding ValidationProgress,
                                        StringFormat='{}{0:F0}'}" />

                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="%" />

                            </StackPanel>

                        </StackPanel>


                    </Grid>


                    <ProgressBar
                        Minimum="0"
                        Maximum="100"
                        Height="8"
                        Value="{Binding ValidationProgress}" />


                </StackPanel>

            </Border>



            <!-- ================================================= -->
            <!-- TEST CARDS -->
            <!-- ================================================= -->

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="16"
                RowSpacing="16">


                <!-- ============================================= -->
                <!-- COMMUNICATION -->
                <!-- ============================================= -->

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Classes="card">

                    <StackPanel
                        Spacing="14">


                        <Grid
                            ColumnDefinitions="*,Auto">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Classes="section-title"
                                    Text="{DynamicResource ValidationCommunication}" />

                                <TextBlock
                                    Classes="muted"
                                    Text="{DynamicResource ValidationCommunicationDescription}" />

                            </StackPanel>


                            <TextBlock
                                Grid.Column="1"
                                Classes="eyebrow"
                                VerticalAlignment="Center"
                                Text="{Binding CommunicationTestStatus}" />

                        </Grid>


                        <Border
                            Classes="card-raised">

                            <TextBlock
                                TextWrapping="Wrap"
                                Text="{Binding CommunicationTestDetails}" />

                        </Border>


                    </StackPanel>

                </Border>



                <!-- ============================================= -->
                <!-- TPS -->
                <!-- ============================================= -->

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Classes="card">

                    <StackPanel
                        Spacing="14">


                        <Grid
                            ColumnDefinitions="*,Auto">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Classes="section-title"
                                    Text="{DynamicResource ValidationTpsSweep}" />

                                <TextBlock
                                    Classes="muted"
                                    Text="{DynamicResource ValidationTpsDescription}" />

                            </StackPanel>


                            <TextBlock
                                Grid.Column="1"
                                Classes="eyebrow"
                                VerticalAlignment="Center"
                                Text="{Binding TpsTestStatus}" />

                        </Grid>


                        <Border
                            Classes="card-raised">

                            <TextBlock
                                TextWrapping="Wrap"
                                Text="{Binding TpsTestDetails}" />

                        </Border>


                    </StackPanel>

                </Border>



                <!-- ============================================= -->
                <!-- MAP -->
                <!-- ============================================= -->

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Classes="card">

                    <StackPanel
                        Spacing="14">


                        <Grid
                            ColumnDefinitions="*,Auto">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Classes="section-title"
                                    Text="{DynamicResource ValidationMapSweep}" />

                                <TextBlock
                                    Classes="muted"
                                    Text="{DynamicResource ValidationMapDescription}" />

                            </StackPanel>


                            <TextBlock
                                Grid.Column="1"
                                Classes="eyebrow"
                                VerticalAlignment="Center"
                                Text="{Binding MapTestStatus}" />

                        </Grid>


                        <Border
                            Classes="card-raised">

                            <TextBlock
                                TextWrapping="Wrap"
                                Text="{Binding MapTestDetails}" />

                        </Border>


                    </StackPanel>

                </Border>



                <!-- ============================================= -->
                <!-- GEAR -->
                <!-- ============================================= -->

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Classes="card">

                    <StackPanel
                        Spacing="14">


                        <Grid
                            ColumnDefinitions="*,Auto">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Classes="section-title"
                                    Text="{DynamicResource ValidationGearDetection}" />

                                <TextBlock
                                    Classes="muted"
                                    Text="{DynamicResource ValidationGearDescription}" />

                            </StackPanel>


                            <TextBlock
                                Grid.Column="1"
                                Classes="eyebrow"
                                VerticalAlignment="Center"
                                Text="{Binding GearTestStatus}" />

                        </Grid>


                        <Border
                            Classes="card-raised">

                            <TextBlock
                                TextWrapping="Wrap"
                                Text="{Binding GearTestDetails}" />

                        </Border>


                    </StackPanel>

                </Border>



                <!-- ============================================= -->
                <!-- SHIFT -->
                <!-- ============================================= -->

                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Classes="card">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="24">


                        <StackPanel
                            Grid.Column="0"
                            Spacing="14">


                            <StackPanel
                                Spacing="3">

                                <TextBlock
                                    Classes="section-title"
                                    Text="{DynamicResource ValidationShiftIndicator}" />

                                <TextBlock
                                    Classes="muted"
                                    TextWrapping="Wrap"
                                    Text="{DynamicResource ValidationShiftDescription}" />

                            </StackPanel>


                            <Border
                                Classes="card-raised">

                                <TextBlock
                                    TextWrapping="Wrap"
                                    Text="{Binding ShiftTestDetails}" />

                            </Border>


                        </StackPanel>



                        <StackPanel
                            Grid.Column="1"
                            MinWidth="120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="7">

                            <TextBlock
                                Classes="eyebrow"
                                HorizontalAlignment="Center"
                                Text="{DynamicResource ValidationResult}" />

                            <TextBlock
                                FontSize="28"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                Text="{Binding ShiftTestStatus}" />

                        </StackPanel>


                    </Grid>

                </Border>


            </Grid>



            <!-- ================================================= -->
            <!-- OVERALL RESULT -->
            <!-- ================================================= -->

            <Border
                Classes="card-raised"
                Padding="28">

                <Grid
                    ColumnDefinitions="*,Auto">


                    <StackPanel
                        Grid.Column="0"
                        Spacing="5">

                        <TextBlock
                            Classes="eyebrow"
                            Text="{DynamicResource ValidationOverallResult}" />

                        <TextBlock
                            FontSize="28"
                            FontWeight="SemiBold"
                            Text="{Binding OverallValidationStatus}" />

                        <TextBlock
                            Classes="muted"
                            Text="{Binding ValidationCurrentStep}" />

                    </StackPanel>



                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Spacing="4">

                        <TextBlock
                            Classes="eyebrow"
                            HorizontalAlignment="Right"
                            Text="{DynamicResource ValidationTarget}" />

                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Right"
                            Text="{Binding ConnectionStatus}" />

                    </StackPanel>


                </Grid>

            </Border>



            <!-- ================================================= -->
            <!-- LAST EVENT -->
            <!-- ================================================= -->

            <Border
                Classes="card">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="12">

                    <TextBlock
                        Grid.Column="0"
                        Classes="eyebrow"
                        VerticalAlignment="Center"
                        Text="{DynamicResource ValidationLastEvent}" />

                    <TextBlock
                        Grid.Column="1"
                        Classes="muted"
                        VerticalAlignment="Center"
                        Text="{Binding LastMessage}" />

                </Grid>

            </Border>


        </StackPanel>

    </ScrollViewer>


</UserControl>